# Tuya WebUI Environment Variables Example
# Copy to .env and edit with your values

# MQTT Broker settings
MQTT_BROKER=192.168.0.3
MQTT_PORT=1883
# Uncomment if needed:
# MQTT_USERNAME=your_username
# MQTT_PASSWORD=your_password

# Topic prefix (should match bridge)
TOPIC_PREFIX=tuya

# WebUI settings
WEBUI_PORT=5386
WEBUI_HOST=0.0.0.0
