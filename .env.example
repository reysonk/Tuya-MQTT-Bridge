# Tuya WiFi → MQTT Bridge — переменные окружения.
#
# Скопируйте этот файл в .env и отредактируйте под себя:
#   cp .env.example .env
#
# Если параметр не задан — используется значение по умолчанию (см. compose).

# Часовой пояс (важно для quiet hours и времени в логах/аналитике)
TZ=Europe/Moscow

# --- MQTT-брокер (обязательно) ---
MQTT_BROKER=192.168.1.10
MQTT_PORT=1883
# Оставьте пустыми, если брокер без авторизации
MQTT_USERNAME=
MQTT_PASSWORD=

# --- Префиксы топиков ---
TOPIC_PREFIX=tuya
DISCOVERY_PREFIX=homeassistant

# --- Уровень логов Bridge: DEBUG / INFO / WARNING / ERROR ---
LOG_LEVEL=INFO

# --- WebUI ---
# WEBUI_PORT — порт на хосте (внутри контейнера всегда 5386)
WEBUI_PORT=5386
WEBUI_HOST=0.0.0.0

# --- Дебаунс (склейка) быстрых команд switch/light ---
# 0 = выключено: первая команда уходит сразу, хвост серии склеивается в одну.
# Включить защиту от спама кликов: поставить 600
SWITCH_DEBOUNCE_MS=0
SWITCH_DEBOUNCE_MAX_MS=1200
